:root {
    --theme-sidebar: {{ theme_sidebar }};
    --theme-sidebar-accent: {{ theme_sidebar_accent }};
    --theme-accent: {{ theme_accent }};
    --theme-on-accent: {{ theme_on_accent }};
    --theme-on-sidebar: {{ theme_on_sidebar }};
    --theme-background: {{ theme_background }};
    --theme-surface: {{ theme_surface }};
    --theme-border: {{ theme_border }};
    --theme-text: {{ theme_text }};
    --theme-text-muted: {{ theme_text_muted }};
    --theme-highlight: {{ theme_highlight }};
    --theme-error: {{ theme_error }};
    --theme-radius: {{ theme_corner_radius }}px;
}

html, body {
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    margin: 0;
    color: var(--theme-text);
    background: var(--theme-background);
}

{{ if theme_heading_font == "cormorantGaramond" }}
.page-header h1,
.sidebar-brand {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
}
.sidebar-tagline.is-cookbook,
.sidebar-header.is-cookbook .sidebar-tagline {
    font-family: 'Dancing Script', cursive;
}
{{ else if theme_heading_font == "playfairDisplay" }}
.page-header h1,
.sidebar-brand {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
}
{{ end }}

a {
    color: inherit;
}

.page {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 280px;
    flex-shrink: 0;
    background: var(--theme-sidebar);
    color: var(--theme-on-sidebar);
    display: flex;
    flex-direction: column;
}

.sidebar-header {
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--theme-on-sidebar) 12%, transparent);
}

.sidebar-header.is-cookbook {
    text-align: center;
}

.sidebar-accent-bar {
    width: 48px;
    height: 3px;
    border-radius: 2px;
    background: var(--theme-accent);
    margin-bottom: 0.875rem;
}

.sidebar-header.is-cookbook .sidebar-accent-bar {
    margin-left: auto;
    margin-right: auto;
}

.sidebar-logo {
    display: block;
    width: 48px;
    height: 48px;
    margin-bottom: 0.75rem;
    border-radius: 10px;
    object-fit: cover;
}

.sidebar-header.is-cookbook .sidebar-logo {
    margin-left: auto;
    margin-right: auto;
}

.sidebar-brand {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
}

.sidebar-tagline {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: color-mix(in srgb, var(--theme-on-sidebar) 72%, transparent);
}

.sidebar-header.is-cookbook .sidebar-tagline {
    font-size: 1rem;
    color: var(--theme-accent);
}

.nav-items {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    flex: 1;
}

.sidebar .nav-link {
    display: block;
    padding: 0.625rem 0.875rem;
    border-radius: var(--theme-radius);
    color: color-mix(in srgb, var(--theme-on-sidebar) 82%, transparent);
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.15s ease, color 0.15s ease;
}

.sidebar .nav-link:hover,
.sidebar .nav-link.is-active {
    background: color-mix(in srgb, var(--theme-accent) 18%, transparent);
    color: var(--theme-accent);
}

.sidebar-footer {
    padding: 0.75rem 1rem 1rem;
    font-size: 0.6875rem;
    color: color-mix(in srgb, var(--theme-on-sidebar) 45%, transparent);
}

.content-shell {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--theme-background);
}

.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.875rem;
    background: var(--theme-surface);
    border-bottom: 1px solid var(--theme-border);
}

.page-header h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--theme-text);
}

.page-header__subtitle {
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--theme-text-muted);
}

.page-body {
    flex: 1;
    padding: 0.5rem 1rem 5rem;
}

.entity-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
}

.entity-card {
    display: flex;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--theme-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
}

.entity-card:hover {
    border-color: color-mix(in srgb, var(--theme-accent) 35%, var(--theme-border));
    box-shadow: 0 1px 3px color-mix(in srgb, var(--theme-text) 8%, transparent);
}

.entity-card__accent {
    width: 4px;
    flex-shrink: 0;
    background: var(--theme-highlight);
}

.entity-card__content {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem;
    flex: 1;
    min-width: 0;
}

.entity-card__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    color: var(--theme-accent);
    font-weight: 700;
}

.entity-card__text {
    flex: 1;
    min-width: 0;
}

.entity-card__title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--theme-text);
}

.entity-card__subtitle {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--theme-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.entity-card__chevron {
    color: var(--theme-text-muted);
    font-size: 1.25rem;
    line-height: 1;
}

.empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--theme-text-muted);
}

.empty-state__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
    font-size: 1.5rem;
}

.empty-state__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--theme-text);
    margin-bottom: 0.5rem;
}

.api-error-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    margin: 0 0 1.25rem;
    padding: 1rem 1.125rem;
    border-radius: var(--theme-radius);
    border: 1px solid color-mix(in srgb, var(--theme-error) 35%, transparent);
    background: color-mix(in srgb, var(--theme-error) 8%, var(--theme-surface));
    color: var(--theme-text);
}

.api-error-alert__icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    background: color-mix(in srgb, var(--theme-error) 14%, transparent);
    color: var(--theme-error);
}

.api-error-alert__title {
    display: block;
    margin-bottom: 0.25rem;
}

.api-error-alert__message {
    margin: 0;
    color: var(--theme-text-muted);
}

.identity-preview {
    background: color-mix(in srgb, var(--theme-text-muted) 8%, var(--theme-surface));
    color: var(--theme-text-muted);
    cursor: not-allowed;
}

.form-field__hint {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    color: var(--theme-text-muted);
}

.btn-fab {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.125rem;
    border-radius: 999px;
    border: none;
    background: var(--theme-accent);
    color: var(--theme-on-accent);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--theme-accent) 35%, transparent);
}

.btn-fab:hover {
    background: color-mix(in srgb, var(--theme-accent) 88%, var(--theme-text));
    color: var(--theme-on-accent);
}

.form-panel {
    max-width: 36rem;
    margin: 1rem;
    padding: 1.25rem;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--theme-radius);
}

.form-field {
    margin-bottom: 12px;
}

.form-field label {
    display: block;
    font-weight: 600;
    margin-bottom: 4px;
}

.btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: var(--theme-radius);
    border: 1px solid transparent;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    font-size: 0.9375rem;
}

.btn-primary {
    background: var(--theme-accent);
    color: var(--theme-on-accent);
    border-color: var(--theme-accent);
}

.btn-primary:hover {
    background: color-mix(in srgb, var(--theme-accent) 88%, var(--theme-text));
    border-color: color-mix(in srgb, var(--theme-accent) 88%, var(--theme-text));
    color: var(--theme-on-accent);
}

.btn-link {
    background: transparent;
    color: var(--theme-accent);
    border: none;
    padding-left: 0;
}

.btn-danger {
    background: var(--theme-error);
    color: #fff;
    border-color: var(--theme-error);
}

.text-danger {
    color: var(--theme-error);
}

input[type="text"],
input[type="number"],
input[type="email"],
input[type="password"],
input[type="date"],
input[type="datetime-local"],
select,
textarea {
    width: 100%;
    max-width: 28rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--theme-border);
    border-radius: var(--theme-radius);
    font: inherit;
    box-sizing: border-box;
    background: var(--theme-surface);
    color: var(--theme-text);
}

input[type="checkbox"] {
    width: auto;
    max-width: none;
}

.form-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1rem;
    flex-wrap: wrap;
}

@media (max-width: 900px) {
    .page {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
    }
}

