@model List<{{ root_namespace }}.Shared.Responses.{{ entity_name }}Response>
@{
    ViewData["Title"] = "{{ entity_name }}";
}

<header class="page-header">
    <div>
        <h1>{{ entity_name }}</h1>
        <p class="page-header__subtitle">{{ entity_description }}</p>
    </div>
</header>

<div class="page-body">
<partial name="_ApiErrorAlert" />
@if (Model.Count == 0 && ViewBag.ApiError is null)
{
    <div class="empty-state">
        <div class="empty-state__icon">☰</div>
        <div class="empty-state__title">No {{ entity_name }} records yet</div>
        <p>Create records in the API to see them here.</p>
    </div>
}
else
{
    <div class="entity-list">
        @foreach (var item in Model)
        {
            <a class="entity-card" asp-action="Edit" asp-route-id="@item.{{ primary_key_name }}">
                <div class="entity-card__accent"></div>
                <div class="entity-card__content">
                    <div class="entity-card__avatar">{{ entity_initial }}</div>
                    <div class="entity-card__text">
                        <div class="entity-card__title">@item.{{ primary_key_name }}</div>
                        <div class="entity-card__subtitle">@item.{{ display_property_name }}</div>
                    </div>
                    <div class="entity-card__chevron">›</div>
                </div>
            </a>
        }
    </div>
}
</div>

<a class="btn-fab" asp-action="Create">+ Add {{ entity_name }}</a>
