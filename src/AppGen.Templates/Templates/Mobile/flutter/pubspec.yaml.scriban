name: {{ app_name_lower }}
description: {{ app_name }} mobile client generated by AppGen.
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.2.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_riverpod: ^2.5.1
  go_router: ^14.2.0
{{ if api_client_enabled }}
  dio: ^5.4.3
{{ end }}
  path_provider: ^2.1.3
  google_fonts: ^6.2.1
  http: ^1.2.2
  package_info_plus: ^8.0.2
  url_launcher: ^6.3.0
{{ for package in capability_packages }}
  {{ package.name }}: {{ package.version }}
{{ end }}

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0

flutter:
  uses-material-design: true
  assets:
    - assets/mobile_config.json
{{ if branding_enabled }}
    - assets/branding/icon.png
{{ end }}
