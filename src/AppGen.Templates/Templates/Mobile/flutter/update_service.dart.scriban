import 'dart:convert';

import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import 'package:package_info_plus/package_info_plus.dart';

class UpdateInfo {
  const UpdateInfo({
    required this.version,
    required this.build,
    required this.apkUrl,
    required this.releaseNotes,
  });

  final String version;
  final int build;
  final String apkUrl;
  final String releaseNotes;

  factory UpdateInfo.fromJson(Map<String, dynamic> json) => UpdateInfo(
        version: json['version'] as String? ?? '',
        build: (json['build'] as num?)?.toInt() ?? 0,
        apkUrl: json['apkUrl'] as String? ?? '',
        releaseNotes: json['releaseNotes'] as String? ?? '',
      );
}

class UpdateService {
  static bool _checkedThisLaunch = false;

  @visibleForTesting
  static bool shouldOfferApkUpdate({
    required int remoteBuild,
    required int installedBuild,
    required String apkUrl,
  }) =>
      remoteBuild > installedBuild && apkUrl.isNotEmpty;

  static Future<UpdateInfo?> checkForUpdate(String updateCheckUrl) async {
    if (kIsWeb) return null;
    if (_checkedThisLaunch) return null;
    _checkedThisLaunch = true;

    final url = updateCheckUrl.trim();
    if (url.isEmpty) return null;

    try {
      final uri = Uri.parse(url);
      final busted = uri.replace(
        queryParameters: {
          ...uri.queryParameters,
          't': DateTime.now().millisecondsSinceEpoch.toString(),
        },
      );
      final response = await http.get(busted).timeout(const Duration(seconds: 8));
      if (response.statusCode != 200) return null;

      final json = jsonDecode(response.body) as Map<String, dynamic>;
      final remote = UpdateInfo.fromJson(json);
      final packageInfo = await PackageInfo.fromPlatform();
      final installedBuild = int.tryParse(packageInfo.buildNumber) ?? 0;

      if (!shouldOfferApkUpdate(
        remoteBuild: remote.build,
        installedBuild: installedBuild,
        apkUrl: remote.apkUrl,
      )) {
        return null;
      }
      return remote;
    } catch (_) {
      return null;
    }
  }
}
