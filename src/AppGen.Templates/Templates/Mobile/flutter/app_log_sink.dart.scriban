import 'dart:async';
import 'dart:io';

import 'package:flutter/foundation.dart';
import 'package:path_provider/path_provider.dart';

/// Swappable application log sink. Replace [instance] to send logs elsewhere.
abstract class AppLogSink {
  static AppLogSink instance = _createDefault();

  void logError(Object error, {StackTrace? stackTrace, String? context});

  static AppLogSink _createDefault() {
    if (kIsWeb) {
      return ConsoleAppLogSink();
    }
    return FileAppLogSink();
  }
}

class ConsoleAppLogSink implements AppLogSink {
  @override
  void logError(Object error, {StackTrace? stackTrace, String? context}) {
    debugPrint('[Error] ${context ?? 'Application error'}: $error');
    if (stackTrace != null) {
      debugPrint(stackTrace.toString());
    }
  }
}

class FileAppLogSink implements AppLogSink {
  FileAppLogSink({this.relativePath = 'logs/app.log'});

  final String relativePath;

  @override
  void logError(Object error, {StackTrace? stackTrace, String? context}) {
    ConsoleAppLogSink().logError(error, stackTrace: stackTrace, context: context);
    unawaited(_appendToFile(error, stackTrace: stackTrace, context: context));
  }

  Future<void> _appendToFile(
    Object error, {
    StackTrace? stackTrace,
    String? context,
  }) async {
    try {
      final baseDirectory = await getApplicationSupportDirectory();
      final logFile = File('${baseDirectory.path}/$relativePath');
      await logFile.parent.create(recursive: true);
      final timestamp = DateTime.now().toIso8601String();
      final buffer = StringBuffer()
        ..writeln('[$timestamp] [Error] ${context ?? 'Application error'}')
        ..writeln(error.toString());
      if (stackTrace != null) {
        buffer.writeln(stackTrace.toString());
      }
      buffer.writeln();
      await logFile.writeAsString(buffer.toString(), mode: FileMode.append);
    } catch (_) {
      // Never crash the app because logging failed.
    }
  }
}
