import '../models/{{ entity_snake }}_model.dart';

class {{ entity_name }}Service {
  {{ entity_name }}Service(this._dio);

  final Dio _dio;

  Future<List<{{ entity_name }}Model>> getAll() async {
    final response = await _dio.get('/api/v1/{{ entity_name }}');
    final data = response.data;
    final list = data is Map && data['data'] != null
        ? data['data'] as List
        : data as List;
    final items = list
        .map((item) => {{ entity_name }}Model.fromJson(item as Map<String, dynamic>))
        .toList();
    items.sort((a, b) => a.{{ key_field }}.compareTo(b.{{ key_field }}));
    return items;
  }

  Future<{{ entity_name }}Model> getById({{ key_dart_type }} id) async {
    final response = await _dio.get('/api/v1/{{ entity_name }}/$id');
    final data = response.data;
    final map = data is Map && data['data'] != null
        ? data['data'] as Map<String, dynamic>
        : data as Map<String, dynamic>;
    return {{ entity_name }}Model.fromJson(map);
  }

  Future<{{ entity_name }}Model> create(Map<String, dynamic> body) async {
    final response = await _dio.post('/api/v1/{{ entity_name }}', data: body);
    final data = response.data;
    final map = data is Map && data['data'] != null
        ? data['data'] as Map<String, dynamic>
        : data as Map<String, dynamic>;
    return {{ entity_name }}Model.fromJson(map);
  }

  Future<{{ entity_name }}Model> update({{ key_dart_type }} id, Map<String, dynamic> body) async {
    final response = await _dio.put('/api/v1/{{ entity_name }}/$id', data: body);
    final data = response.data;
    final map = data is Map && data['data'] != null
        ? data['data'] as Map<String, dynamic>
        : data as Map<String, dynamic>;
    return {{ entity_name }}Model.fromJson(map);
  }

  Future<void> delete({{ key_dart_type }} id) async {
    await _dio.delete('/api/v1/{{ entity_name }}/$id');
  }

{{ if has_identity_key }}
  Future<{{ key_dart_type }}> getNextId() async {
    final response = await _dio.get('/api/v1/{{ entity_name }}/next-id');
    final data = response.data;
    final value = data is Map && data['data'] != null ? data['data'] : data;
    if (value is int) return value;
    if (value is num) return value.toInt();
    return {{ key_dart_type }}.parse(value.toString());
  }

{{ end }}
}

final {{ entity_snake }}ServiceProvider = Provider<{{ entity_name }}Service>((ref) {
