import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'app/router.dart';
import 'app/theme.dart';
import 'core/platform/android_back_bridge.dart';

void main() {
  runApp(const ProviderScope(child: {{ app_class_name }}App()));
}

class {{ app_class_name }}App extends ConsumerStatefulWidget {
  const {{ app_class_name }}App({super.key});

  @override
  ConsumerState<{{ app_class_name }}App> createState() => _{{ app_class_name }}AppState();
}

class _{{ app_class_name }}AppState extends ConsumerState<{{ app_class_name }}App> {
  var _backBridgeInstalled = false;

  @override
  Widget build(BuildContext context) {
    final router = ref.watch(appRouterProvider);
    if (!_backBridgeInstalled) {
      _backBridgeInstalled = true;
      AndroidBackBridge.install(router);
    }
    return MaterialApp.router(
      title: '{{ app_name }}',
      theme: buildAppTheme(),
      routerConfig: router,
    );
  }
}
