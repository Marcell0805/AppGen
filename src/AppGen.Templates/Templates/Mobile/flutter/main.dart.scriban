import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'app/router.dart';
import 'app/theme.dart';
import 'core/logging/app_log_sink.dart';
import 'core/widgets/update_prompt_listener.dart';

void main() {
  // Default sink is FileAppLogSink (mobile/desktop) or ConsoleAppLogSink (web).
  // AppLogSink.instance = RemoteAppLogSink();

  ErrorWidget.builder = (details) {
    AppLogSink.instance.logError(
      details.exception,
      stackTrace: details.stack,
      context: 'Widget build error',
    );
    return Material(
      color: Colors.white,
      child: Center(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Text(
            'Something went wrong loading this screen.',
            textAlign: TextAlign.center,
            style: TextStyle(color: Colors.grey.shade700),
          ),
        ),
      ),
    );
  };

  runApp(const ProviderScope(child: {{ app_class_name }}App()));
}

class {{ app_class_name }}App extends ConsumerWidget {
  const {{ app_class_name }}App({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final router = ref.watch(appRouterProvider);
    final app = MaterialApp.router(
      title: '{{ app_name }}',
      theme: buildAppTheme(),
      routerConfig: router,
    );
    return UpdatePromptListener(child: app);
  }
}
