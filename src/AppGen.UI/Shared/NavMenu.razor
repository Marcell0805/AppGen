@using AppGen.UI.Services
@inject UiThemeService Theme
@inject IJSRuntime JS
@implements IDisposable

<div class="nav-menu-root">
    <div class="top-row ps-3 navbar navbar-dark appgen-brand-row">
        <a class="navbar-brand appgen-brand" href="/project">
            <img src="assets/logo-icon.svg" alt="" class="brand-icon" />
            <span class="brand-lockup">
                <span class="brand-text">AppGen</span>
                <span class="brand-tagline">Application factory</span>
            </span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>

    <div class="@NavMenuCssClass nav-menu-body" @onclick="ToggleNavMenu">
        <nav class="flex-column appgen-nav">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="project" Match="NavLinkMatch.All">
                    <span class="nav-icon" aria-hidden="true">@((MarkupString)ProjectIcon)</span> Project
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="documentation">
                    <span class="nav-icon" aria-hidden="true">@((MarkupString)DocIcon)</span> Documentation
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="web">
                    <span class="nav-icon" aria-hidden="true">@((MarkupString)WebIcon)</span> Web
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mobile">
                    <span class="nav-icon" aria-hidden="true">@((MarkupString)MobileIcon)</span> Mobile
                </NavLink>
            </div>
        </nav>
    </div>

    <div class="nav-footer">
        <label class="theme-toggle">
            <input type="checkbox"
                   checked="@Theme.IsDark"
                   @onchange="OnThemeChanged"
                   disabled="@(!_themeReady)" />
            <span>Dark theme</span>
        </label>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool _themeReady;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized() => Theme.Changed += OnThemeServiceChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var theme = await JS.InvokeAsync<string>("appgen.getTheme");
            Theme.SetDark(theme == "dark", notify: false);
            await JS.InvokeVoidAsync("appgen.setTheme", Theme.IsDark ? "dark" : "light");
            _themeReady = true;
        }
        catch (JSException)
        {
            _themeReady = false;
        }

        StateHasChanged();
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task OnThemeChanged(ChangeEventArgs args)
    {
        var isDark = args.Value is bool b && b
                     || args.Value is string s && bool.TryParse(s, out var parsed) && parsed;
        Theme.SetDark(isDark, notify: false);
        try
        {
            await JS.InvokeVoidAsync("appgen.setTheme", isDark ? "dark" : "light");
            _themeReady = true;
        }
        catch (JSException)
        {
            // Keep UI state; avoid taking down the Blazor circuit if JS is stale/missing.
        }
    }

    private void OnThemeServiceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeServiceChanged;

    private const string ProjectIcon = """<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h18"/></svg>""";

    private const string DocIcon = """<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>""";

    private const string WebIcon = """<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>""";

    private const string MobileIcon = """<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>""";
}
